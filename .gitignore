# Todo App Fullstack - Enhanced .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov
.nyc_output

# Test results
test-results/
playwright-report/
test-results.xml
junit.xml

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.vercel/
.netlify/

# TypeScript
*.tsbuildinfo
typings/

# Cache directories
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.eslintcache
.stylelintcache

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database files
*.db
*.sqlite
*.sqlite3
database.db

# Log files
logs/
*.log
backend.log
frontend.log

# Temporary folders
tmp/
temp/

# Package files
*.tgz
.yarn-integrity

# IDE and Editor files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
*.bak
*.backup

# Playwright browsers
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Husky
.husky/_

# Monorepo specific
shared/dist/
shared/lib/

# Development tools
.browser_screenshots/
storybook-static/

# Security
.env.example
!.env.example

# Documentation build
docs/build/