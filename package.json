{
  "name": "todo-app-fullstack",
  "version": "1.0.0",
  "description": "Full-stack Todo application with NestJS and Next.js",
  "private": true,
  "workspaces": [
    "todo-backend",
    "todo-frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd todo-backend && npm run start:dev",
    "dev:frontend": "cd todo-frontend && npm run dev",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "cd shared && npm run build",
    "build:backend": "cd todo-backend && npm run build",
    "build:frontend": "cd todo-frontend && npm run build",
    "test": "npm run test:shared && npm run test:backend && npm run test:frontend",
    "test:shared": "cd shared && npm test",
    "test:backend": "cd todo-backend && npm test",
    "test:frontend": "cd todo-frontend && npm test",
    "test:e2e": "npm run test:e2e:backend && npm run test:e2e:frontend",
    "test:e2e:backend": "cd todo-backend && npm run test:e2e",
    "test:e2e:frontend": "cd todo-frontend && npm run test:e2e",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:frontend",
    "test:coverage:backend": "cd todo-backend && npm run test:cov",
    "test:coverage:frontend": "cd todo-frontend && npm run test:coverage",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd todo-backend && npm run lint",
    "lint:frontend": "cd todo-frontend && npm run lint",
    "format": "npm run format:backend && npm run format:frontend",
    "format:backend": "cd todo-backend && npm run format",
    "format:frontend": "cd todo-frontend && npm run format",
    "clean": "npm run clean:backend && npm run clean:frontend",
    "clean:backend": "cd todo-backend && rm -rf dist node_modules",
    "clean:frontend": "cd todo-frontend && rm -rf .next node_modules",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "install:backend": "cd todo-backend && npm install",
    "install:frontend": "cd todo-frontend && npm install",
    "generate:feature": "node scripts/generate-feature.js",
    "generate:component": "node scripts/generate-component.js",
    "setup:dev": "npm run install:all && npm run build:shared"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}